+func _random_plan() -> Array:
+	var rng := RandomNumberGenerator.new()
+	rng.seed = int(OS.get_environment("MOVE_SEED")) if OS.get_environment("MOVE_SEED") != "" else 1
+	var n := int(OS.get_environment("MOVE_SEGMENTS")) if OS.get_environment("MOVE_SEGMENTS") != "" else 24
+	var mode_a := OS.get_environment("MOVE_MODE") if OS.get_environment("MOVE_MODE") != "" else "mixed"
+	var run_a := OS.get_environment("MOVE_RUN") if OS.get_environment("MOVE_RUN") != "" else "mixed"
+	var turn_a := OS.get_environment("MOVE_TURN") if OS.get_environment("MOVE_TURN") != "" else "low"
+	var jump_a := OS.get_environment("MOVE_JUMP") == "1"
+	var max_turn := 20.0 if turn_a == "low" else 120.0
+	var heading := 0.0
+	var out := []
+	for i in n:
+		heading = fposmod(heading + rng.randf_range(-max_turn, max_turn), 360.0)
+		var mode := STAND
+		match mode_a:
+			"crouch":
+				mode = CROUCH
+			"crawl":
+				mode = CRAWL
+			"mixed":
+				var r := rng.randf()
+				mode = STAND if r < 0.7 else (CROUCH if r < 0.88 else CRAWL)
+		var running := false
+		if mode == STAND:
+			running = (rng.randf() < 0.4) if run_a == "mixed" else (run_a == "1")
+		var mag := 1.0 if running else rng.randf_range(0.35, 1.0)
+		var dir := Vector2(sin(deg_to_rad(heading)), cos(deg_to_rad(heading))) * mag
+		if rng.randf() < 0.08:
+			dir = Vector2.ZERO  # let go of the stick: stop
+		var jump := jump_a and mode == STAND and rng.randf() < 0.2
+		out.append(["r%d" % i, dir, running, rng.randf_range(1.5, 4.0), heading, mode, jump])
+	return out
+
